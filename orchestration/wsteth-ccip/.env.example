# Copy to .env and fill. RPC_SEPOLIA / RPC_<L2 SLUG> are REQUIRED (no committed fallback) — they
# are normally already exported by the AnvilForksTray app (see ../forks); set them here otherwise.
# RPC_SEPOLIA=            # L1 endpoint (your tray port or a keyed archive endpoint)

# L2 chain selection (default mantle_sepolia). Slugs = config/chains/<slug>.json; the RPC env
# var is RPC_<UPPERCASED SLUG>.
# L2_CHAIN=mantle_sepolia
# RPC_MANTLE_SEPOLIA=         # required (tray port or keyed endpoint)
# RPC_MANTLE_SEPOLIA_REMOTE=  # optional keyed endpoint for step 10

# Disposable testnet deployer (anvil dev key #0 by default; forks accept it).
# 0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
DEPLOYER_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

# Governance actors OTHER than the deployer. A BIP39 phrase whose derived accounts hold the
# non-deployer roles, so the role matrix is observable instead of collapsed onto one key:
#   account 1 = emergency_brakes AND guardian  (the Emergency Multisig: halters + veto)
#   account 2 = chainlink_mcms                 (PROPOSER_ROLE + HALT_ROLE)
#   account 3 = generated, unused              (reserved for splitting the guardian off)
# The deploy itself never signs with these — only DEPLOYER_PRIVATE_KEY does. They are addresses in
# config/chains/*.json; the phrase exists so those actors can be DRIVEN (pause, veto, propose) in
# tests and manual ops, on a fork or on a live testnet, with no impersonation.
# Generate with:  cast wallet new-mnemonic --words 24
# Derive with:    cast wallet derive-private-key "$ACTORS_MNEMONIC" <index>
# Deliberately NOT anvil's public "test test … junk" phrase: those keys are known to everyone, so
# on a live chain anyone could pause the bridge.
ACTORS_MNEMONIC="<24 words — see above; the committed addresses must match what this derives>"

# core (Lido + DG) scratch deploy: path to the vendored hardhat submodule (lidofinance/core, feat/scratch-dg).
# Defaults to lib/core; set this only to point at an out-of-tree checkout.
CORE_DIR=lib/core

# Sepolia genesis params (used by core's scratch deploy step 0000)
GENESIS_TIME=1655733600
GENESIS_FORK_VERSION=0x90000069

# Scratch Lido ships paused unless this is on. Core's PROTOCOL_ACTIVATION_ENABLED
# (lib/core/lib/env-flags.ts, opt-in default OFF) makes step 0155 call Lido.resume()
# before Dual Governance takes the Agent. script/01_l1_core_dg.sh defaults it ON;
# set 0 to keep the historical paused bootstrap (resume later via script/12_resume_lido.sh).
# PROTOCOL_ACTIVATION_ENABLED=1
