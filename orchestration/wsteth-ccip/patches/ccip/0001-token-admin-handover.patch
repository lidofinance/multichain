-  /// @dev Only for a token deployed by 1_Deploy. The admin transfer is two-step: the Lido DAO accepts it itself.
+  /// @dev Complete token-admin-only work before the DAO can accept its two-step admin transfer.
+  /// TAR administration stays with the deployer until script 3, independently of token administration.
   function _configureTokenIfNeeded() internal {
     if (!s_tokenDeployedByScripts) return;
 
     BurnMintERC20Transparent token = BurnMintERC20Transparent(s_chainConfig.addresses.token);
+    TokenAdminRegistry registry = TokenAdminRegistry(s_ccip.token_admin_registry);
+    TokenAdminRegistry.TokenConfig memory config = registry.getTokenConfig(address(token));
+    if (config.administrator != address(0) && config.administrator != s_deployer) {
+      revert UnexpectedTokenAdministrator(config.administrator);
+    }
+    if (config.pendingAdministrator != address(0) && config.pendingAdministrator != s_deployer) {
+      revert UnexpectedPendingTokenAdministrator(config.pendingAdministrator);
+    }
+    if (config.administrator == address(0) && config.pendingAdministrator == address(0)) {
+      RegistryModuleOwnerCustom(s_ccip.registry_module_owner).registerAdminViaGetCCIPAdmin(address(token));
+      config = registry.getTokenConfig(address(token));
+    }
+    if (config.pendingAdministrator == s_deployer) registry.acceptAdminRole(address(token));
+    address administrator = registry.getTokenConfig(address(token)).administrator;
+    if (administrator != s_deployer) revert UnexpectedTokenAdministrator(administrator);
+
     token.grantMintAndBurnRoles(s_deployed.token_pool);
+    token.setCCIPAdmin(s_chainConfig.governance_addresses.lido_dao_agent);
     token.beginDefaultAdminTransfer(s_chainConfig.governance_addresses.lido_dao_agent);
   }
 
