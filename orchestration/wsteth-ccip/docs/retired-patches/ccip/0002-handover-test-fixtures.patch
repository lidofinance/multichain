   function test_checkDeployedTokenHandoverToDao_PassesAfterDaoAccepted() public {
+    s_token.setCCIPAdmin(s_dao);
+    s_token.beginDefaultAdminTransfer(s_dao);
+    vm.warp(block.timestamp + 1);
+    vm.prank(s_dao);
+    s_token.acceptDefaultAdminTransfer();
+
+    s_script.exposed_checkDeployedTokenHandoverToDao();
+  }
+
+  function _completeHandover(
+    bool registered,
+    bool proposed,
+    bool configureFirst
+  ) internal {
+    s_registry = new TokenAdminRegistry();
+    RegistryModuleOwnerCustom registryModule = new RegistryModuleOwnerCustom(address(s_registry));
+    s_registry.addRegistryModule(address(registryModule));
+    s_script.setRegistry(address(s_registry));
+    s_script.setRegistryModule(address(registryModule));
+    if (registered || proposed) s_registry.proposeAdministrator(address(s_token), address(this));
+    if (registered) s_registry.acceptAdminRole(address(s_token));
+    PoolOperationManager manager = _deployManager(s_pool);
+    s_script.setManagedContracts(address(manager), s_pool, address(0), address(0), address(0));
+    vm.etch(s_pool, hex"00");
+    vm.mockCall(s_pool, abi.encodeWithSignature("isSupportedToken(address)", address(s_token)), abi.encode(true));
+    if (configureFirst) {
+      new ConfigureTokenHarness()
+        .configureToken(address(s_token), s_pool, s_dao, address(s_registry), address(registryModule));
+      assertEq(s_token.getCCIPAdmin(), s_dao);
+      assertEq(s_registry.getTokenConfig(address(s_token)).administrator, address(this));
+      assertTrue(s_token.hasRole(s_token.MINTER_ROLE(), s_pool));
+      assertTrue(s_token.hasRole(s_token.BURNER_ROLE(), s_pool));
+      vm.warp(block.timestamp + 1);
+      vm.prank(s_dao);
+      s_token.acceptDefaultAdminTransfer();
+    } else {
+      s_token.beginDefaultAdminTransfer(s_dao);
+    }
+    (, uint48 schedule) = s_token.pendingDefaultAdmin();
+
+    s_script.exposed_completeHandover();
+
+    assertEq(s_token.getCCIPAdmin(), s_dao);
+    (address pendingAdmin, uint48 afterSchedule) = s_token.pendingDefaultAdmin();
+    assertEq(pendingAdmin, configureFirst ? address(0) : s_dao);
+    assertEq(s_token.defaultAdmin(), configureFirst ? s_dao : address(this));
+    assertEq(afterSchedule, schedule, "default admin transfer must not restart");
+    TokenAdminRegistry.TokenConfig memory config = s_registry.getTokenConfig(address(s_token));
+    assertEq(config.administrator, address(manager));
+    assertEq(config.tokenPool, s_pool);
+    assertTrue(manager.hasRole(bytes32(0), s_dao));
+    assertFalse(manager.hasRole(bytes32(0), address(this)));
+    // Completed handovers remain safe to re-run after the deployer relinquishes POM administration.
+    s_script.exposed_completeHandover();
+  }
