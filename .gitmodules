[submodule "components/ccip"]
	path = components/ccip
	url = git@github.com:smartcontractkit/ccip-contract-examples-internal.git
	# Branch-based Pages cannot read this private dependency. Developers opt in with --checkout.
	update = none
[submodule "components/core"]
	path = components/core
	branch = feat/scratch-dg
	url = git@github.com:lidofinance/core.git
[submodule "libs/forge-std"]
	path = libs/forge-std
	url = https://github.com/foundry-rs/forge-std
[submodule "components/governance-crosschain-bridges"]
	path = components/governance-crosschain-bridges
	url = https://github.com/lidofinance/governance-crosschain-bridges
[submodule "libs/state-mate"]
	path = libs/state-mate
	branch = feat/separate-deployed
	url = git@github.com:lidofinance/state-mate.git
[submodule "components/openzeppelin-contracts-5.0.2"]
	path = components/openzeppelin-contracts-5.0.2
	url = https://github.com/OpenZeppelin/openzeppelin-contracts
[submodule "components/openzeppelin-contracts-upgradeable-5.0.2"]
	path = components/openzeppelin-contracts-upgradeable-5.0.2
	url = https://github.com/OpenZeppelin/openzeppelin-contracts-upgradeable
[submodule "components/openzeppelin-contracts-5.3.0"]
	path = components/wsteth-token/lib/openzeppelin-contracts-5.3.0
	url = https://github.com/OpenZeppelin/openzeppelin-contracts
