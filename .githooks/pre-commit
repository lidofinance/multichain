#!/usr/bin/env bash
# Dispatcher: runs each module's own pre-commit hook and fails if any fails.
#
# Git resolves core.hooksPath to one directory, so module hooks cannot register
# themselves. Each module keeps its check under <module>/hooks/pre-commit and
# decides for itself whether the staged content concerns it; this file owns
# only the ordering and the combined exit status.
#
# Wire up once per clone:  git config core.hooksPath .githooks
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

modules=(ledger dashboard)

status=0
for module in "${modules[@]}"; do
  hook="$module/hooks/pre-commit"
  [[ -f "$hook" ]] || continue
  if ! bash "$hook"; then
    echo "pre-commit: $module hook failed." >&2
    status=1
  fi
done
exit $status
